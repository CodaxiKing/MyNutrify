# Banco de dados (obrigatório)
# Local:  postgres://usuario:senha@127.0.0.1:5432/mynutrify
# Neon:   postgres://user:pass@ep-xxx.neon.tech/mynutrify?sslmode=require
DATABASE_URL=postgres://mynutrify:mynutrify@127.0.0.1:5432/mynutrify

# SSL do Postgres. Liga sozinho em produção; use "false" num Postgres local.
PGSSL=false

PORT=5000
NODE_ENV=development

# Análise de alimentos por imagem.
# Sem DISABLE_OPENAI_MOCK=true o servidor devolve um resultado fixo
# ("Grilled Chicken Breast") em vez de chamar a API — útil para desenvolver
# sem gastar créditos.
OPENAI_API_KEY=
DISABLE_OPENAI_MOCK=false

# Assinaturas (opcional — sem isso a tela de planos não fecha a compra)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
STRIPE_VIP_MONTHLY_PRICE_ID=
STRIPE_VIP_YEARLY_PRICE_ID=

# Origem das mídias dos exercícios (imagens/GIFs de demonstração).
#   vazio  -> CDN do dataset upstream (padrão)
#   off    -> desliga as demonstrações
#   <url>  -> seu próprio storage
# As mídias são © Gym visual e NÃO são MIT — leia EXERCISES-NOTICE.md antes de
# publicar o app. A atribuição é exibida automaticamente.
VITE_EXERCISE_MEDIA_BASE_URL=

# Quem pode criar conta:
#   first-user  só até existir a primeira conta com senha (padrão)
#   true        qualquer pessoa
#   false       cadastro fechado
ALLOW_REGISTRATION=first-user

# Domínios extras liberados no CORS, separados por vírgula.
# As origens do app nativo (http://localhost, capacitor://localhost) já são
# liberadas por padrão — só preencha se servir a web em outro domínio.
CORS_ORIGINS=

# USDA FoodData Central — base pública gratuita com ~250 mil alimentos.
# Chave grátis em https://fdc.nal.usda.gov/api-key-signup (1.000 req/hora).
# Deixe vazio para desligar: a busca segue com TACO + OpenFoodFacts.
USDA_API_KEY=
